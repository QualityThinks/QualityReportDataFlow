# Copy this file to .env and fill in the values.
# Values marked (encrypted) must be the output of:
#     python script\encrypt_value.py "<plain value>"
# Step-by-step guide: installation-module\module-en.md

# encryption_key
# generate with: python script\create_key.py
ENCRYPTION_ALGORITHM = aes-gcm
ENCRYPTION_KEY = your_key

# database variables
MYSQL_HOST = localhost
MYSQL_PORT = 3306
MYSQL_DATABASE = your_database
MYSQL_USER = your_user
# (encrypted) leave empty when the MySQL user has no password
MYSQL_PASSWORD =

# email variables (Gmail with OAuth2, no app password needed)
# the Gmail address that signs in and sends the report
SMTP_USER = your_account@gmail.com
# Client ID of the "Desktop app" OAuth client in Google Cloud console
OAUTH_CLIENT_ID = your_client_id.apps.googleusercontent.com
# (encrypted) the Client secret of that OAuth client
OAUTH_CLIENT_SECRET = your_encrypted_client_secret
# (encrypted) printed by: python script\create_oauth_token.py
OAUTH_REFRESH_TOKEN = your_encrypted_refresh_token
# report recipients, separated by commas
EMAIL_RECIPIENT = recipient@example.com

# optional email variables (remove the # to use)
# replaces the default subject, which ends with today's date
# EMAIL_SUBJECT = [QID] Quality Inspection Device - Rungkut 1 - Unit 1
# From address; defaults to SMTP_USER (must be SMTP_USER or one of its Gmail "Send mail as" aliases)
# EMAIL_SENDER = your_account@gmail.com
# Gmail connection; 465 + ssl also works if port 587 is blocked
# SMTP_PORT = 587
# SMTP_SECURITY = starttls
# SMTP_TIMEOUT = 30

# data result (written into every row of the report)
PLANT = RK1
LOCATION = U6
GROUP = 99
BRAND = DUMMY
SET_SAMPLE = 1
BAGIAN = Rolling & Cutting
