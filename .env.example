MYSQL_HOST = your_address
MYSQL_PORT = your_port
MYSQL_DATABASE = your_database
MYSQL_USER = your_username
MYSQL_PASSWORD = your_password

EMAIL_SENDER = sender@example.com
EMAIL_RECIPIENT = recipient@example.com
EMAIL_SUBJECT = Quality Report
EMAIL_BODY = Hello,\n\nPlease find the attached quality report.\n\nRegards,\nAutomation

# sendEmail.py: smtp or outlook (outlook requires Outlook desktop + pywin32)
EMAIL_SEND_METHOD = smtp
SMTP_HOST = smtp.example.com
SMTP_PORT = 587
# starttls (port 587), ssl (port 465) or none (port 25, internal relay)
SMTP_SECURITY = starttls
SMTP_USER = sender@example.com
SMTP_PASSWORD = your_password
SMTP_TIMEOUT = 30
